# ── Hetzner + Cloudflare uchun .env namunasi ──
# Bu faylni .env nomi bilan saqlang va o'z qiymatlaringizni kiriting

DEBUG=False

# SQLite (oddiy) yoki PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./yukgo.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/yukgo

# Redis (ixtiyoriy)
REDIS_URL=redis://localhost:6379/0

# Security — o'zgartiring!
SECRET_KEY=change-this-to-very-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=your_bot_username

TEMP_TOKEN_EXPIRE_SECONDS=300
